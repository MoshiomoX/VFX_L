<?xml version="1.0" encoding="utf-8"?>
<!--
  HLSL を fxc に渡す前に UTF-8（BOM なし）にそろえる（VFX_L.vcxproj から Import）。
  BOM は fxc が X3000 で止まり、Shift-JIS は「ソ・表・予」などで // コメントが次の行を飲み込むので、
  どちらも Tools/FixHlslEncoding.ps1 が自動で直す（直したファイルは警告 HLSLENC で出る）。
  Shader\ 以下の .hlsl / .hlsli のどれかが前回より新しいときだけ動く（スタンプは $(IntDir)）。
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="VfxlCollectHlsl">
    <ItemGroup>
      <VfxlHlslSource Include="$(MSBuildProjectDirectory)\Shader\**\*.hlsl;$(MSBuildProjectDirectory)\Shader\**\*.hlsli" />
    </ItemGroup>
  </Target>

  <Target Name="VfxlFixHlslEncoding"
          BeforeTargets="FxCompile"
          DependsOnTargets="VfxlCollectHlsl"
          Condition="'@(FxCompile)' != ''"
          Inputs="@(VfxlHlslSource)"
          Outputs="$(IntDir)vfxl_hlsl_encoding.stamp">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)FixHlslEncoding.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)\Shader&quot; -Utf8Output"
          StdOutEncoding="utf-8"
          StdErrEncoding="utf-8" />
    <Touch Files="$(IntDir)vfxl_hlsl_encoding.stamp" AlwaysCreate="true" />
  </Target>
</Project>
