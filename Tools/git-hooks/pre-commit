#!/bin/sh
# Tools/git-hooks/pre-commit（2026-11-05）
# コミットする HLSL（.hlsl / .hlsli / .fx / .fxh）の中身が「UTF-8・BOM なし」かを確かめる。
#   見るのはインデックスに入った物（git add した中身）。作業ツリーのファイルではない。
#   fxc は BOM があると 1 行目で X3000。Shift-JIS だと「ソ・表・能・予」などの 2 バイト目 0x5C（\）が
#   // コメントの行末に来て、次の行がコメントに飲み込まれる（黙ってコードが消える）。
#   VS で構築すれば Tools/HlslEncoding.targets が直すが、別のエディタで直して構築せずに
#   コミットするとすり抜けるので、ここで止める。
# 入れ方（クローンごとに 1 回）: git config core.hooksPath Tools/git-hooks
# 直し方: powershell -NoProfile -ExecutionPolicy Bypass -File Tools/FixHlslEncoding.ps1 -Root VFX_L/Shader
#         の後で git add し直す。どうしても通す時は git commit --no-verify。
# このファイルは LF のまま（.gitattributes で eol=lf。CRLF だと sh が 1 行目を読めない）。

bad=0
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.hlsl' '*.hlsli' '*.fx' '*.fxh')
[ -z "$files" ] && exit 0

IFS='
'
for f in $files; do
    head3=$(git show ":$f" | head -c 3 | od -An -tx1 | tr -d ' \n')
    if [ "$head3" = "efbbbf" ]; then
        echo "pre-commit: $f has a UTF-8 BOM (fxc stops with X3000)"
        bad=1
    fi
    if ! git show ":$f" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
        echo "pre-commit: $f is not UTF-8 (Shift-JIS? a trailing 0x5C eats the next line)"
        bad=1
    fi
done

if [ "$bad" -ne 0 ]; then
    echo "pre-commit: fix with"
    echo "  powershell -NoProfile -ExecutionPolicy Bypass -File Tools/FixHlslEncoding.ps1 -Root VFX_L/Shader"
    echo "then git add the files again (or commit with --no-verify to skip this check)."
    exit 1
fi
exit 0
